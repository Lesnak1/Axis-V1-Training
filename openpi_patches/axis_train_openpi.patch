+def axis_clean_local_root(data_config: _config.DataConfig) -> pathlib.Path | None:
+    root = getattr(data_config, "axis_clean_root", None)
+    if root:
+        return pathlib.Path(root).expanduser().resolve()
+
+    repo_id = data_config.repo_id or ""
+    if repo_id.startswith(_AXIS_CLEAN_LOCAL_PREFIX):
+        return pathlib.Path(repo_id[len(_AXIS_CLEAN_LOCAL_PREFIX) :]).expanduser().resolve()
+
+    return None
+

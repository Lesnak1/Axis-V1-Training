+def _axis_clean_env_int(name: str) -> int | None:
+    raw_value = os.environ.get(name)
+    if raw_value is None or raw_value == "":
+        return None
+    value = int(raw_value)
+    if value < 1:
+        raise ValueError(f"{name} must be >= 1, got {value}")
+    return value
+
+
+def _axis_clean_task_id(path: pathlib.Path) -> int | None:
+    match = re.match(r"task_(\d+)_", path.name)
+    return int(match.group(1)) if match else None
+
+
+def _axis_clean_selected_task_dirs(root: pathlib.Path) -> list[pathlib.Path]:
+    if not root.exists():
+        raise FileNotFoundError(f"AXIS clean data root not found: {root}")
+
+    task_dirs = sorted(path for path in root.glob("task_*_isaac_state_train") if path.is_dir())
+    explicit_task_ids = os.environ.get("OPENPI_AXIS_CLEAN_TASK_IDS")
+    if explicit_task_ids:
+        selected_ids = {
+            int(value.strip())
+            for value in explicit_task_ids.replace(";", ",").split(",")
+            if value.strip()
+        }
+        task_dirs = [path for path in task_dirs if _axis_clean_task_id(path) in selected_ids]
+
+    max_tasks = _axis_clean_env_int("OPENPI_AXIS_CLEAN_MAX_TASKS")
+    if max_tasks is not None:
+        task_dirs = task_dirs[:max_tasks]
+
+    if not task_dirs:
+        raise FileNotFoundError(
+            f"No AXIS clean task directories selected under {root}. "
+            "Check OPENPI_AXIS_CLEAN_TASK_IDS / OPENPI_AXIS_CLEAN_MAX_TASKS."
+        )
+    return task_dirs
+
+
+def _axis_clean_tasks_by_index(task_dir: pathlib.Path) -> dict[int, str]:
+    tasks_path = task_dir / "meta" / "tasks.parquet"
+    if not tasks_path.exists():
+        return {}
+
+    tasks_df = pd.read_parquet(tasks_path).reset_index()
+    tasks: dict[int, str] = {}
+    for default_index, row in tasks_df.iterrows():
+        task_index = int(row["task_index"]) if "task_index" in row else int(default_index)
+        if "task" in row:
+            prompt = str(row["task"])
+        else:
+            prompt = str(row.iloc[0])
+        tasks[task_index] = prompt
+    return tasks
+

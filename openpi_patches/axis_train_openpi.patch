+class AxisCleanLocalLeRobotV3Dataset(torch.utils.data.Dataset):
+    """Local multi-task AXIS-format LeRobot-v3 reader.
+
+    Source state/action must be 9D:
+        [left_gripper_qpos, right_gripper_qpos, arm_joint_1, ..., arm_joint_7]
+
+    Returned samples use OpenPI's DROID keys and 8D DROID-style state/actions.
+    """
+
+    def __init__(
+        self,
+        root: str | pathlib.Path,
+        *,
+        action_horizon: int,
+        velocity_scale: float = 1.0 / 15.0,
+        downsample_ratio: int = 2,
+        gripper_open_q: Sequence[float] = (0.04, 0.04),
+        gripper_close_q: Sequence[float] = (0.0, 0.0),
+        clip_velocity_actions: bool = True,
+    ):
+        self._root = pathlib.Path(root).expanduser().resolve()
+        self._action_horizon = int(action_horizon)
+        self._velocity_scale = float(velocity_scale)
+        self._downsample_ratio = int(downsample_ratio)
+        if self._downsample_ratio < 1:
+            raise ValueError(f"downsample_ratio must be >= 1, got {downsample_ratio}")
+        self._gripper_open_q = tuple(float(value) for value in gripper_open_q)
+        self._gripper_close_q = tuple(float(value) for value in gripper_close_q)
+        self._clip_velocity_actions = bool(clip_velocity_actions)
+        self._max_samples_per_task = _axis_clean_env_int("OPENPI_AXIS_CLEAN_MAX_SAMPLES_PER_TASK")
+        self._video_container_cache_size = int(os.environ.get("OPENPI_AXIS_CLEAN_VIDEO_CONTAINER_CACHE_SIZE", "16"))
+        self._video_container_cache = collections.OrderedDict()
+
+        self._stores: list[dict] = []
+        self._cumulative_lengths: list[int] = []
+        total = 0
+        skipped = 0
+
+        for task_dir in _axis_clean_selected_task_dirs(self._root):
+            try:
+                store = self._load_task(task_dir)
+            except (FileNotFoundError, KeyError, ValueError) as exc:
+                skipped += 1
+                logging.warning("Skipping AXIS clean task %s: %s", task_dir, exc)
+                continue
+
+            total += int(store["length"])
+            self._stores.append(store)
+            self._cumulative_lengths.append(total)
+
+        if total == 0:
+            raise ValueError(f"AXIS clean dataset is empty after scanning {self._root}; skipped={skipped}")
+
+        logging.info(
+            "Loaded AXIS clean LeRobot-v3 dataset: root=%s tasks=%d skipped=%d samples=%d "
+            "downsample_ratio=%d velocity_scale=%.6f",
+            self._root,
+            len(self._stores),
+            skipped,
+            total,
+            self._downsample_ratio,
+            self._velocity_scale,
+        )
+
+    def __getstate__(self):
+        state = self.__dict__.copy()
+        state["_video_container_cache"] = collections.OrderedDict()
+        return state
+
+    def _get_video_stream(self, path: str):
+        import av
+
+        cached = self._video_container_cache.get(path)
+        if cached is not None:
+            self._video_container_cache.move_to_end(path)
+            return cached
+
+        container = av.open(path)
+        stream = container.streams.video[0]
+        cached = (container, stream)
+        self._video_container_cache[path] = cached
+        if self._video_container_cache_size > 0:
+            while len(self._video_container_cache) > self._video_container_cache_size:
+                _, (old_container, _) = self._video_container_cache.popitem(last=False)
+                old_container.close()
+        return cached
+
+    def _load_task(self, task_dir: pathlib.Path) -> dict:
+        info_path = task_dir / "meta" / "info.json"
+        if not info_path.exists():
+            raise FileNotFoundError(f"missing {info_path}")
+        info = json.loads(info_path.read_text(encoding="utf-8"))
+        fps = float(info.get("fps", 30))
+        video_path_template = str(
+            info.get("video_path", "videos/{video_key}/chunk-{chunk_index:03d}/file-{file_index:03d}.mp4")
+        )
+
+        episode_files = sorted((task_dir / "meta" / "episodes").glob("**/*.parquet"))
+        data_files = sorted((task_dir / "data").glob("**/*.parquet"))
+        if not episode_files:
+            raise FileNotFoundError("missing meta/episodes parquet files")
+        if not data_files:
+            raise FileNotFoundError("missing data parquet files")
+
+        episodes = pd.concat([pd.read_parquet(path) for path in episode_files], ignore_index=True)
+        episodes = episodes.sort_values("episode_index").reset_index(drop=True)
+        required_episode_columns = (
+            "dataset_to_index",
+            "videos/observation.images.third_person/chunk_index",
+            "videos/observation.images.third_person/file_index",
+            "videos/observation.images.third_person/from_timestamp",
+            "videos/observation.images.wrist/chunk_index",
+            "videos/observation.images.wrist/file_index",
+            "videos/observation.images.wrist/from_timestamp",
+        )
+        missing_episode_columns = [column for column in required_episode_columns if column not in episodes]
+        if missing_episode_columns:
+            raise KeyError(f"missing episode video columns: {missing_episode_columns}")
+
+        data = pd.concat([pd.read_parquet(path) for path in data_files], ignore_index=True)
+        data = data.sort_values("index").reset_index(drop=True)
+        states = np.stack(data["observation.state"].to_numpy()).astype(np.float32)
+        actions = np.stack(data["action"].to_numpy()).astype(np.float32)
+        if states.shape != actions.shape or states.ndim != 2 or states.shape[1] != 9:
+            raise ValueError(f"expected state/action arrays with shape (N, 9), got {states.shape} and {actions.shape}")
+
+        episode_ends = episodes["dataset_to_index"].to_numpy(np.int64)
+        if episode_ends.ndim != 1 or len(episode_ends) == 0 or int(episode_ends[-1]) > len(states):
+            raise ValueError(f"invalid dataset_to_index values: last={episode_ends[-1] if len(episode_ends) else None}")
+
+        sample_indices = axis_downsampled_frame_indices(episode_ends, self._downsample_ratio)
+        if self._max_samples_per_task is not None and len(sample_indices) > self._max_samples_per_task:
+            sample_indices = sample_indices[
+                np.linspace(0, len(sample_indices) - 1, self._max_samples_per_task, dtype=np.int64)
+            ]
+        if len(sample_indices) == 0:
+            raise ValueError("no sampled frames")
+
+        return {
+            "path": task_dir,
+            "fps": fps,
+            "video_path_template": video_path_template,
+            "episodes": episodes.set_index("episode_index"),
+            "episode_ends": episode_ends,
+            "timestamps": data["timestamp"].to_numpy(np.float32),
+            "episode_indices": data["episode_index"].to_numpy(np.int64),
+            "task_indices": data["task_index"].to_numpy(np.int64),
+            "tasks": _axis_clean_tasks_by_index(task_dir),
+            "state": states,
+            "action": actions,
+            "sample_indices": sample_indices,
+            "length": int(len(sample_indices)),
+        }
+
+    def __len__(self) -> int:
+        return self._cumulative_lengths[-1]
+
+    def _read_video_frame(self, path: str, frame_index: int) -> np.ndarray:
+        container, stream = self._get_video_stream(path)
+        target_pts = int(round(int(frame_index) / float(stream.average_rate) / float(stream.time_base)))
+        container.seek(target_pts, any_frame=False, backward=True, stream=stream)
+        last_frame = None
+        for frame in container.decode(stream):
+            last_frame = frame
+            if frame.pts is None or frame.pts >= target_pts:
+                return frame.to_ndarray(format="rgb24")
+        if last_frame is None:
+            raise IndexError(f"No frames decoded from {path}")
+        return last_frame.to_ndarray(format="rgb24")
+
+    def _image_at(self, store: dict, video_key: str, local_index: int) -> np.ndarray:
+        episode_index = int(store["episode_indices"][local_index])
+        episode = store["episodes"].loc[episode_index]
+        prefix = f"videos/{video_key}"
+        video_timestamp = float(episode[f"{prefix}/from_timestamp"]) + float(store["timestamps"][local_index])
+        frame_index = int(round(video_timestamp * float(store["fps"])))
+        filename = store["video_path_template"].format(
+            video_key=video_key,
+            chunk_index=int(episode[f"{prefix}/chunk_index"]),
+            file_index=int(episode[f"{prefix}/file_index"]),
+        )
+        return self._read_video_frame(str(store["path"] / filename), frame_index)
+
+    def _state_actions_for_indices(self, store: dict, local_indices: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+        episode_ends = store["episode_ends"]
+        episode_indices = np.searchsorted(episode_ends, local_indices, side="right")
+        batch_episode_ends = episode_ends[episode_indices]
+        action_indices = np.minimum(
+            local_indices[:, None]
+            + np.arange(self._action_horizon, dtype=np.int64)[None, :] * self._downsample_ratio,
+            batch_episode_ends[:, None] - 1,
+        )
+        states = axis_droid_state_from_qpos(
+            store["state"][local_indices],
+            gripper_open_q=self._gripper_open_q,
+            gripper_close_q=self._gripper_close_q,
+        )
+        actions = axis_droid_actions_from_qpos(
+            store["state"][action_indices],
+            store["action"][action_indices],
+            velocity_scale=self._velocity_scale,
+            gripper_open_q=self._gripper_open_q,
+            gripper_close_q=self._gripper_close_q,
+            clip_velocity_actions=self._clip_velocity_actions,
+        )
+        return states, actions
+
+    def iter_state_action_batches(
+        self,
+        *,
+        batch_size: int = 8192,
+        max_frames: int | None = None,
+    ) -> Iterator[tuple[np.ndarray, np.ndarray]]:
+        per_store_limit = None
+        if max_frames is not None:
+            per_store_limit = max(1, int(np.ceil(max_frames / len(self._stores))))
+        emitted = 0
+
+        for store in self._stores:
+            selected = store["sample_indices"]
+            if per_store_limit is not None and len(selected) > per_store_limit:
+                selected = selected[np.linspace(0, len(selected) - 1, per_store_limit, dtype=np.int64)]
+
+            for start in range(0, len(selected), batch_size):
+                if max_frames is not None and emitted >= max_frames:
+                    return
+                frame_indices = selected[start : start + batch_size]
+                if max_frames is not None:
+                    frame_indices = frame_indices[: max_frames - emitted]
+                emitted += len(frame_indices)
+                yield self._state_actions_for_indices(store, frame_indices)
+
+    def __getitem__(self, index: SupportsIndex) -> dict:
+        global_index = int(index.__index__())
+        if global_index < 0:
+            global_index += len(self)
+        if global_index < 0 or global_index >= len(self):
+            raise IndexError(global_index)
+
+        store_index = bisect.bisect_right(self._cumulative_lengths, global_index)
+        previous_total = 0 if store_index == 0 else self._cumulative_lengths[store_index - 1]
+        local_sample_index = global_index - previous_total
+        store = self._stores[store_index]
+        local_index = int(store["sample_indices"][local_sample_index])
+        state, actions = self._state_actions_for_indices(store, np.asarray([local_index], dtype=np.int64))
+        task_index = int(store["task_indices"][local_index])
+
+        return {
+            "observation.exterior_image_1_left": self._image_at(store, "observation.images.third_person", local_index),
+            "observation.wrist_image_left": self._image_at(store, "observation.images.wrist", local_index),
+            "observation.joint_position": state[0, :7],
+            "observation.gripper_position": state[0, 7:8],
+            "actions": actions[0],
+            "prompt": store["tasks"].get(task_index, store["path"].name),
+        }
+
+
+def compute_axis_clean_droid_norm_stats(
+    data_config: _config.DataConfig,
+    action_horizon: int,
+    *,
+    max_frames: int | None = None,
+    batch_size: int = 8192,
+) -> dict[str, _transforms.NormStats]:
+    root = axis_clean_local_root(data_config)
+    if root is None:
+        raise ValueError("AXIS clean root is not configured.")
+
+    dataset = AxisCleanLocalLeRobotV3Dataset(
+        root,
+        action_horizon=action_horizon,
+        velocity_scale=data_config.axis_clean_velocity_scale,
+        downsample_ratio=data_config.axis_clean_downsample_ratio,
+        gripper_open_q=data_config.axis_clean_gripper_open_q,
+        gripper_close_q=data_config.axis_clean_gripper_close_q,
+        clip_velocity_actions=data_config.axis_clean_clip_velocity_actions,
+    )
+    stats = {key: _normalize.RunningStats() for key in ["state", "actions"]}
+    total = 0
+    for states, actions in dataset.iter_state_action_batches(batch_size=batch_size, max_frames=max_frames):
+        stats["state"].update(states)
+        stats["actions"].update(actions)
+        total += states.shape[0]
+    if total == 0:
+        raise ValueError("No frames selected for AXIS clean norm stats.")
+    return {key: value.get_statistics() for key, value in stats.items()}
+
+
+def axis_droid_closedness_from_widths(
+    gripper_qpos: np.ndarray,
+    *,
+    open_q: Sequence[float],
+    close_q: Sequence[float],
+) -> np.ndarray:
+    qpos = np.asarray(gripper_qpos, dtype=np.float32)
+    open_arr = np.asarray(open_q, dtype=np.float32)
+    close_arr = np.asarray(close_q, dtype=np.float32)
+    if qpos.shape[-1] != open_arr.shape[0] or qpos.shape[-1] != close_arr.shape[0]:
+        raise ValueError(
+            "gripper_qpos, open_q, and close_q must have the same final dimension: "
+            f"qpos={qpos.shape} open={open_arr.shape} close={close_arr.shape}"
+        )
+    denom = np.where(np.abs(open_arr - close_arr) > 1e-6, open_arr - close_arr, 1e-6)
+    open_ratio = np.clip((qpos - close_arr) / denom, 0.0, 1.0).mean(axis=-1, keepdims=True)
+    return (1.0 - open_ratio).astype(np.float32)
+
+
+def axis_droid_state_from_qpos(
+    source_state: np.ndarray,
+    *,
+    gripper_open_q: Sequence[float],
+    gripper_close_q: Sequence[float],
+) -> np.ndarray:
+    source_state = np.asarray(source_state, dtype=np.float32)
+    if source_state.shape[-1] != 9:
+        raise ValueError(f"Expected AXIS joint state/action dim 9, got {source_state.shape}")
+    arm_state = source_state[..., 2:9]
+    gripper_closedness = axis_droid_closedness_from_widths(
+        source_state[..., :2],
+        open_q=gripper_open_q,
+        close_q=gripper_close_q,
+    )
+    return np.concatenate([arm_state, gripper_closedness], axis=-1).astype(np.float32)
+
+
+def axis_droid_actions_from_qpos(
+    source_state: np.ndarray,
+    source_action: np.ndarray,
+    *,
+    velocity_scale: float,
+    gripper_open_q: Sequence[float],
+    gripper_close_q: Sequence[float],
+    clip_velocity_actions: bool,
+) -> np.ndarray:
+    source_state = np.asarray(source_state, dtype=np.float32)
+    source_action = np.asarray(source_action, dtype=np.float32)
+    if source_state.shape[-1] != 9 or source_action.shape[-1] != 9:
+        raise ValueError(f"Expected AXIS joint state/action dim 9, got {source_state.shape} and {source_action.shape}")
+    if velocity_scale <= 0.0:
+        raise ValueError(f"velocity_scale must be positive, got {velocity_scale}")
+
+    arm_velocity_style_action = (source_action[..., 2:9] - source_state[..., 2:9]) / float(velocity_scale)
+    if clip_velocity_actions:
+        arm_velocity_style_action = np.clip(arm_velocity_style_action, -1.0, 1.0)
+    gripper_closedness = axis_droid_closedness_from_widths(
+        source_action[..., :2],
+        open_q=gripper_open_q,
+        close_q=gripper_close_q,
+    )
+    return np.concatenate([arm_velocity_style_action, gripper_closedness], axis=-1).astype(np.float32)
+
+
+def axis_downsampled_frame_indices(episode_ends: np.ndarray, downsample_ratio: int) -> np.ndarray:
+    ratio = int(downsample_ratio)
+    if ratio < 1:
+        raise ValueError(f"downsample_ratio must be >= 1, got {downsample_ratio}")
+
+    ends = np.asarray(episode_ends, dtype=np.int64)
+    if ends.ndim != 1 or len(ends) == 0:
+        raise ValueError(f"episode_ends must be a non-empty 1D array, got {ends.shape}")
+
+    selected: list[np.ndarray] = []
+    episode_start = 0
+    for episode_end in ends:
+        episode_end = int(episode_end)
+        if episode_end <= episode_start:
+            raise ValueError(f"episode_ends must be strictly increasing, got {ends}")
+        selected.append(np.arange(episode_start, episode_end, ratio, dtype=np.int64))
+        episode_start = episode_end
+
+    return np.concatenate(selected) if selected else np.empty((0,), dtype=np.int64)
+
